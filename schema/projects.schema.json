{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SnehanshnC/content-pack/schema/projects.schema.json",
  "title": "Projects",
  "type": "object",
  "additionalProperties": false,
  "required": ["projects", "awards", "programs"],
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "label": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "note": { "type": "string" }
      }
    },
    "linkValue": {
      "oneOf": [
        { "$ref": "#/$defs/link" },
        { "type": "array", "items": { "$ref": "#/$defs/link" }, "minItems": 1 }
      ]
    }
  },
  "properties": {
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "summary"],
        "properties": {
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "highlights": {
            "type": "array",
            "items": { "type": "string" }
          },
          "stack": {
            "type": "array",
            "items": { "type": "string" }
          },
          "built_at": { "type": "string" },
          "date": { "type": "string" },
          "teammates": {
            "type": "array",
            "items": { "type": "string" }
          },
          "links": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/linkValue" }
          },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "awards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "project", "event"],
        "properties": {
          "slug": { "type": "string" },
          "project": { "type": "string" },
          "event": { "type": "string" },
          "year": { "type": "integer" },
          "placement": { "type": "string" },
          "track": { "type": "string" },
          "participants": { "type": "string" },
          "prize": { "type": "string" },
          "selection": { "type": "string" },
          "extras": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "detail"],
        "properties": {
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "detail": { "type": "string" },
          "year": { "type": "integer" },
          "date": { "type": "string" }
        }
      }
    }
  }
}
